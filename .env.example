# ---- MMA OS environment configuration ----
# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-openssl-rand-base64-48
DATABASE_URL=file:./data/mma.db

# Development-only bootstrap admin (username: admin / password: admin)
# NEVER enable in production. Production requires BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@mmaos.local
# Production: set a strong password and force rotation on first login
FORCE_ADMIN_PASSWORD_CHANGE=false

# Billing (Stripe test mode). Leave empty to use the built-in sandbox provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
BILLING_PROVIDER=auto

# Email (transactional). Leave empty to log emails to the server console / outbox.
RESEND_API_KEY=
EMAIL_FROM="MMA OS <no-reply@mmaos.local>"

# Retention / privacy
DATA_RETENTION_DAYS=730
