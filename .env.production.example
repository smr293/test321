# ---- MMA OS production environment ----
# Copy to .env and fill every value before `docker compose up -d`.

NODE_ENV=production
APP_URL=https://app.example.com
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# SQLite (default). Absolute paths in Docker should stay under /app/data.
DATABASE_URL=file:./data/mma.db

# Customer demos only: seeds two synthetic gyms + demo logins on first boot.
# Leave "false" for real gym data. Also hides the app from search engines and
# shows a "Demo environment" badge.
DEMO_SEED=false

# First-run platform administrator. Disable after creating your own admins.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_USERNAME=admin
# Minimum 12 characters; rotate immediately after first login.
BOOTSTRAP_ADMIN_PASSWORD=
FORCE_ADMIN_PASSWORD_CHANGE=true

# Stripe (optional). Leave blank to run the sandbox provider (no real charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Transactional email (optional). Without a key, messages go to the outbox.
RESEND_API_KEY=
EMAIL_FROM="MMA OS <no-reply@yourdomain.com>"

# Scheduled maintenance endpoint (/api/cron/maintenance) bearer token.
CRON_SECRET=

# Privacy
DATA_RETENTION_DAYS=730
# Deleting old audit entries breaks chain continuity unless re-chained; opt-in only.
AUDIT_PURGE_ENABLED=false
